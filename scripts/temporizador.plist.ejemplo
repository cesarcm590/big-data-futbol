<?xml version="1.0" encoding="UTF-8"?>
<!--
  Temporizador de la actualización del dashboard (launchd, agente del usuario).

  Corre DOS veces por semana a propósito, porque los dos trabajos son distintos y ninguno sirve en el momento del otro:
    lunes 09:07  - ya están los resultados del fin de semana: califica el seguimiento en vivo y republica.
    viernes 09:07  - football-data ya publicó el calendario de la jornada siguiente: CONGELA esas predicciones
                     antes de que se juegue nada. Si esto no corre a tiempo, esa jornada se pierde para siempre
                     del seguimiento en vivo, porque solo cuenta lo que se dijo ANTES del partido.

  Instalar:    sed "s|RUTA_DEL_PROYECTO|$(pwd)|g; s|RUTA_DE_TU_PYTHON|$(which python)|g" \\
                   scripts/temporizador.plist.ejemplo > ~/Library/LaunchAgents/com.futbol.actualizar.plist
               launchctl load ~/Library/LaunchAgents/com.futbol.actualizar.plist

  OJO: el proyecto tiene que estar FUERA de ~/Desktop, ~/Documents y ~/Downloads. macOS protege esas carpetas con
  TCC y un agente de launchd no puede leerlas sin Acceso a Disco Completo (falla con "can't open input file").
  Desinstalar: launchctl unload ~/Library/LaunchAgents/com.futbol.actualizar.plist
  Probar ya:   launchctl start com.futbol.actualizar
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.futbol.actualizar</string>

  <key>ProgramArguments</key>
  <array>
    <string>RUTA_DEL_PROYECTO/scripts/actualizar_semanal.sh</string>
  </array>

  <!-- launchd no hereda el PATH del usuario: hay que decirle qué intérprete usar. -->
  <key>EnvironmentVariables</key>
  <dict><key>FUTBOL_PYTHON</key><string>RUTA_DE_TU_PYTHON</string></dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>7</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>7</integer></dict>
  </array>

  <!-- Si la Mac estaba apagada o dormida a esa hora, launchd lo corre en cuanto despierte. -->
  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>RUTA_DEL_PROYECTO/registro/launchd_salida.log</string>
  <key>StandardErrorPath</key>
  <string>RUTA_DEL_PROYECTO/registro/launchd_error.log</string>
</dict>
</plist>
